<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:background="#FFFFFF">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report Status"
        android:textColor="#3C693D"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30sp"
        android:paddingBottom="8dp" />

    <!-- Scrollable Filter Buttons -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/btn_submitted"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:minWidth="90dp"
                android:paddingHorizontal="16dp"
                android:text="Submitted"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:background="@drawable/active"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_under_review"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingHorizontal="16dp"
                android:text="Under Review"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:background="@drawable/inactive"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_in_progress"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:minWidth="95dp"
                android:paddingHorizontal="16dp"
                android:text="In Progress"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:background="@drawable/inactive"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_completed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:minWidth="90dp"
                android:paddingHorizontal="16dp"
                android:text="Completed"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:background="@drawable/inactive" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Reports RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
</LinearLayout>